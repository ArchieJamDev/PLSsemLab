msgid "Bank customers, with demographics (n=675)"
msgstr "Clientes de bancos, con variables demográficas (n=675)"

#: R/texts.R
msgid "Below 0.02: no effect"
msgstr "Menor de 0.02: sin efecto"

#: R/texts.R
msgid "Below 0.85: distinct constructs"
msgstr "Menor de 0.85: constructos distintos"

#: R/texts.R
msgid "Below 3: no collinearity problem"
msgstr "Menor de 3: sin problema de colinealidad"

#: plssem/options/edgeColor/black.title
msgid "Black"
msgstr "Negro"

#: plssem/ui[3].label
#: plssem/results/bootStatus.title
msgid "Bootstrap"
msgstr "Bootstrap"

#: R/texts.R
msgid "Bootstrap running: %d of %d resamples done. Changing any option stops it."
msgstr ""
"Bootstrap en curso: %d de %d réplicas hechas. Cambiar cualquier opción lo "
"detiene."

#: R/texts.R
msgid ""
"Bootstrap: %d resamples drawn, %d admissible and used; seed %d; drawn in "
"blocks of %d (block k uses the seed + k - 1); %d s. Intervals are percentile "
"intervals at %s%%."
msgstr ""
"Bootstrap: %d réplicas extraídas, %d admisibles y usadas; semilla %d; "
"extraídas en bloques de %d (el bloque k usa la semilla + k - 1); %d s. Los "
"intervalos son percentiles al %s%%."

#: R/texts.R
msgid ""
"Bootstrap: %d resamples with seed %d; percentile intervals at %s%%. Each "
"resample redraws the cases with replacement and re-estimates the model, so "
"the spread of the estimates shows their sampling uncertainty. The seed makes "
"the result reproducible: the same seed and resamples give the same "
"intervals. Inadmissible resamples are dropped and counted in the bootstrap "
"note. 2000 or more resamples are recommended for a final report (Hair et "
"al., 2019, see references)."
msgstr ""
"Bootstrap: %d réplicas con semilla %d; intervalos percentiles al %s%%. Cada "
"réplica vuelve a extraer los casos con reemplazo y reestima el modelo, así "
"que la dispersión de las estimaciones muestra su incertidumbre muestral. La "
"semilla hace reproducible el resultado: la misma semilla y el mismo número "
"de réplicas dan los mismos intervalos. Las réplicas inadmisibles se "
"descartan y se cuentan en la nota del bootstrap. Para un informe final se "
"recomiendan 2000 réplicas o más (Hair et al., 2019, vea las referencias)."

#: R/texts.R
msgid ""
"Bootstrap: not run. The tables show estimates without significance; tick Run "
"bootstrap in the Bootstrap box to add intervals, standard errors and p "
"values."
msgstr ""
"Bootstrap: no ejecutado. Las tablas muestran estimaciones sin significación; "
"marque Ejecutar bootstrap en la caja Bootstrap para añadir intervalos, "
"errores estándar y valores p."

