msgstr "Efectos directos, indirectos y totales"

#: plssem/results/htmt.title
#: plssem/results/htmtPlot.title
msgid "Discriminant validity (HTMT)"
msgstr "Validez discriminante (HTMT)"

#: R/texts.R
msgid "Discriminant validity (HTMT) compares pairs of reflective constructs; the model has only one."
msgstr "La validez discriminante (HTMT) compara pares de constructos reflectivos; el modelo tiene solo uno."

#: R/texts.R
msgid "Discriminant validity: %d of %d pair(s) of reflective constructs have HTMT below 0.85."
msgstr "Validez discriminante: %d de %d par(es) de constructos reflectivos tienen un HTMT menor de 0.85."

#: R/texts.R
msgid "Discriminant validity: every HTMT is below 0.85, so the data distinguish the %d reflective constructs from each other."
msgstr "Validez discriminante: todos los HTMT son menores de 0.85, así que los datos distinguen entre sí los %d constructos reflectivos."

#: R/texts.R
msgid "Discriminant validity: HTMT could not be computed for %s (see the footnotes of the HTMT table)."
msgstr "Validez discriminante: el HTMT no pudo calcularse para %s (vea las notas al pie de la tabla HTMT)."

#: R/texts.R
msgid "Discriminant validity: HTMT is 0.85 or more for %s. The data barely distinguish these constructs; ask whether they measure the same concept, whether some indicators belong to both, or whether they should be merged."
